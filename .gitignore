/verify/run_tests/test_temp/
test_temp/

# --- Local Configurations & Credentials ---
/config.yaml
/config.local.yaml
/api_keys.json
/keys/
*.pem
*.key
.env*
!.env.example

# --- Local MCP Protocols, Agents & Credentials ---
