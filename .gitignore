/protocols/
# Local agent profiles, snapshots and runtime archives
/agents/
/.agents/

# --- Internal Documentation & Task Tracking ---
/docs/adr/
/docs/specs/
/docs/tickets/
/tasks/
/rules/
/SPEC.md
/CONTEXT.md
/GLOSSARY.md

# --- Runtime Caches, Locks & Databases ---
/schemas/
/logs/
*.log
*.jsonl
*.duckdb*
wire.duckdb
.faradaiwire.lock
*.pid
*.lock

# --- Web Frontend (React / Vite) ---
node_modules/
web/node_modules/
web/.vite/
web/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# --- Python Test Suites (verify/) ---
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

