# ==============================================================================
# FaradAiWire - Environment Configuration Template
# ==============================================================================

# Core Gateway Runtime Settings
FARADAI_WIRE_ENV=development                 # 'development' for relaxed local checks, 'production' for strict enforcement
FARADAI_WIRE_HOST=127.0.0.1                  # Bind host interface (use 0.0.0.0 for Docker containers)
FARADAI_WIRE_HOME=~/.faradaiwire                 # Base directory for runtime config, keys, and DuckDB storage
GATEWAY_ID=farad-ai-gw-local-01          # Unique identifier for this gateway node
FARADAI_WIRE_DEFAULT_AGENT=default           # Default agent domain directory if not specified in request

# Authentication & Security
API_KEY=faw_live_dev_master_secret_12345 # Master key for Admin endpoints and agent ingress authentication
FARADAI_WIRE_HMAC_SECRET=                    # Optional 32-byte HMAC secret for context anti-spoofing verification

# Local Upstream Connectivity
FARADAI_WIRE_ALLOW_LOCAL_TARGETS=true        # Set 'true' to allow SSRF bypass for localhost/private MCP servers

# Process & Concurrency Control
FARADAI_WIRE_DISABLE_PROCESS_LOCK=false      # Set 'true' only in CI/testing to bypass flock single-instance guard
